<ui:FluentWindow
    x:Class="Helinstaller.Views.Windows.UnattendConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Настройка автоматической установки Windows (OOBE)" 
    Height="640" Width="860"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Шапка окна с системными кнопками -->
            <RowDefinition Height="Auto"/>
            <!-- Основная область навигации и контента -->
            <RowDefinition Height="*"/>
            <!-- Подвал -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ТАЙТЛБАР -->
        <ui:TitleBar Title="Автоустановка Windows (OOBE)" Grid.Row="0"/>

        <!-- 2. СЕТКА КОНТЕНТА -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Верхняя строка под горизонтальную навигацию -->
                <RowDefinition Height="Auto"/>
                <!-- Нижняя строка под карточки настроек -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ГОРИЗОНТАЛЬНОЕ МЕНЮ (Задали Grid.Row="0", убрали сдвигающий заголовок PaneTitle) -->
            <ui:NavigationView x:Name="DialogNavigation" 
                               Grid.Row="0"
                               PaneDisplayMode="Top"
                               IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="SecurityItem" Content="Безопасность и Сеть" Icon="{ui:SymbolIcon Shield24}" Tag="security" Click="NavigationViewItem_Click"/>
                    <ui:NavigationViewItem x:Name="PerformanceItem" Content="Службы и Оптимизация" Icon="{ui:SymbolIcon LauncherSettings24}" Tag="performance" Click="NavigationViewItem_Click"/>
                    <ui:NavigationViewItem x:Name="InterfaceItem" Content="Интерфейс и Твики" Icon="{ui:SymbolIcon SlideText24}" Tag="interface" Click="NavigationViewItem_Click"/>
                    <ui:NavigationViewItem x:Name="DebloaterItem" Content="Удаление программ" Icon="{ui:SymbolIcon Delete24}" Tag="debloater" Click="NavigationViewItem_Click"/>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- КОНТЕНТНАЯ ОБЛАСТЬ (Задали Grid.Row="1", выровняли отступы) -->
            <Grid Grid.Row="1" Margin="15,10,15,15">

                <!-- ВКЛАДКА 1: БЕЗОПАСНОСТЬ И СЕТЬ -->
                <ScrollViewer x:Name="SecurityScroll" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <StackPanel>
                        <!-- TPM / RAM Check -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Обход требований Windows 11" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Позволяет установить ОС на старые ПК без поддержки TPM 2.0, Secure Boot и RAM." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BypassRequirementsCheck, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Bypass Network -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Пропуск настройки сети и MSA" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Позволяет настроить локальную учетную запись в OOBE без подключения к интернету." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BypassNetworkCheck, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- SmartScreen (Опасный пункт) -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="#FF3B30" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Отключить Defender SmartScreen [Опасно]" FontWeight="SemiBold" FontSize="13" Foreground="#FF3B30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:TextBlock Text="Убирает предупреждения при запуске непроверенных файлов. Повышает риск случайного заражения ПК." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableSmartScreen, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- SAC (Опасный пункт) -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="#FF3B30" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Отключить Smart App Control (SAC) [Опасно]" FontWeight="SemiBold" FontSize="13" Foreground="#FF3B30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:TextBlock Text="Отключает облачную службу фильтрации вредоносных и неподписанных программ." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableSac, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- UAC (Опасный пункт - Исправили на Опасно) -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="Yellow" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Отключить контроль учетных записей (UAC) [Небезопасно]" FontWeight="SemiBold" FontSize="13" Foreground="Yellow" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <ui:TextBlock Text="Убирает всплывающие окна подтверждения прав. Любое вирусное ПО сможет получить полные права администратора скрытно!" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    <ui:TextBlock Text="Включайте только если уверены, что будете аккуратны." Foreground="Yellow" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableUac, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Core Isolation -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить изоляцию ядра (Core Isolation)" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Отключает целостность памяти (HVCI) для прироста FPS в играх и стабильной работы старых драйверов." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableCoreIsolation, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- WPBT -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Блокировать платформу WPBT" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Предотвращает автоматическое навязывание OEM-софта (например, Armoury Crate) напрямую из BIOS." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableWpbt, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ВКЛАДКА 2: ОПТИМИЗАЦИЯ И СЛУЖБЫ -->
                <ScrollViewer x:Name="PerformanceScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Windows Update (Опасный пункт - Исправили на Красный + Опасно) -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="#FF3B30" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Приостановить автоматические обновления [Опасно]" FontWeight="SemiBold" FontSize="13" Foreground="#FF3B30" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:TextBlock Text="Ставит обновления Windows на паузу. Система перестанет получать важные исправления безопасности против новых интернет-угроз." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableWindowsUpdate, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Widgets -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить панель виджетов новостей и погоды" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Убирает панель виджетов с панели задач Windows 11, существенно освобождая оперативную память." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableWidgets, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- System Restore -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить точки восстановления (System Restore)" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Выключает фоновую службу теневого копирования диска C для экономии ресурса SSD." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableSystemRestore, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Fast Startup -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить быстрый запуск (Fast Startup)" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Выключает гибридный режим сна, решая проблемы с незакрывающимися фоновыми процессами." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisableFastStartup, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- BitLocker -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить авто-шифрование дисков BitLocker" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Блокирует принудительное фоновое шифрование накопителей при первой установке системы." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PreventDeviceEncryption, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Pointer Precision -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Отключить акселерацию указателя мыши" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Выравнивает точность (1-to-1 сенсор) для улучшения мышечной памяти в играх." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisablePointerPrecision, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- RDP -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Включить удаленный рабочий стол (RDP)" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Разрешает удаленное подключение к этому компьютеру по локальной сети." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRemoteDesktop, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Long Paths -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Включить поддержку длинных путей Win32" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Снимает древнее ограничение Windows в 260 символов на общую длину пути к папке или файлу." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableLongPaths, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Windows Old / Password -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <UniformGrid Columns="2">
                                <CheckBox IsChecked="{Binding DeleteWindowsOld, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          Content="Очистить Windows.old после установки" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding PasswordExpirationUnlimited, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          Content="Бесконечный срок пароля учетки" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ВКЛАДКА 3: ИНТЕРФЕЙС И КАСТОМИЗАЦИЯ -->
                <ScrollViewer x:Name="InterfaceScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Context Menu -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ui:TextBlock Text="Классическое контекстное меню Windows 10" FontWeight="SemiBold" FontSize="13"/>
                                    <ui:TextBlock Text="Возвращает старое, быстрое контекстное меню по правому клику мыши в Windows 11." FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ClassicContextMenu, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                            </Grid>
                        </ui:Card>

                        <!-- Left Taskbar / TaskView -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <UniformGrid Columns="2">
                                <CheckBox IsChecked="{Binding AlignTaskbarLeft, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          Content="Панель задач по левому краю" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding HideTaskViewButton, RelativeSource={RelativeSource AncestorType=Window}}" 
                                          Content="Скрыть значок «Представление задач»" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </ui:Card>

                        <!-- Explorer Tweaks -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <ui:TextBlock Text="Отображение файлов и папок" FontTypography="Body" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <CheckBox IsChecked="{Binding ShowFileExtensions, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Показывать расширения файлов" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding ShowHiddenFiles, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Показывать скрытые файлы" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding LaunchToThisPC, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Открывать на «Этот компьютер»" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding HideInfoTip, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Скрыть всплывающие подсказки" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding ShowAllTrayIcons, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Всегда разворачивать значки трея" Margin="0,4"/>
                                </UniformGrid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Personalization -->
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <ui:TextBlock Text="Визуальный стиль и реклама" FontTypography="Body" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <CheckBox IsChecked="{Binding SystemColorThemeDark, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Тёмный системный интерфейс" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding AppsColorThemeDark, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Тёмная тема для Проводника" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding DisableBingResults, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Блокировать поиск Bing в Пуске" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding DisableAppSuggestions, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Запретить автоустановку тиктоков" Margin="0,4"/>
                                    <CheckBox IsChecked="{Binding TurnOffSystemSounds, RelativeSource={RelativeSource AncestorType=Window}}" 
                                              Content="Отключить системные звуки" Margin="0,4"/>
                                </UniformGrid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ВКЛАДКА 4: УДАЛЕНИЕ ПРОГРАММ -->
                <Grid x:Name="DebloaterScroll" Margin="0,0,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="12">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ClearStartPins, RelativeSource={RelativeSource AncestorType=Window}}" 
                                      Content="Полностью очистить закрепленные значки в меню «Пуск»" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="Вырезает все рекламные ярлыки (TikTok, Instagram, Disney+, Spotify) из меню Пуск при первом входе." 
                                       FontSize="11" Opacity="0.6" Margin="24,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ui:TextBlock Grid.Row="0" Text="Выберите встроенные приложения для удаления:" FontTypography="Body" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <UniformGrid Columns="2" VerticalAlignment="Top">
                                    <CheckBox Content="Удалить Microsoft Teams" Margin="0,4" IsChecked="{Binding RemoveTeams, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Microsoft OneDrive" Margin="0,4" IsChecked="{Binding RemoveOneDrive, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Cortana / Copilot" Margin="0,4" IsChecked="{Binding RemoveCortana, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Clipchamp" Margin="0,4" IsChecked="{Binding RemoveClipchamp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Солитер (Solitaire)" Margin="0,4" IsChecked="{Binding RemoveSolitaire, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Записки (StickyNotes)" Margin="0,4" IsChecked="{Binding RemoveStickyNotes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить To-Do списки" Margin="0,4" IsChecked="{Binding RemoveTodos, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Центр отзывов" Margin="0,4" IsChecked="{Binding RemoveFeedbackHub, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Get Help (Справка)" Margin="0,4" IsChecked="{Binding RemoveGetHelp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Bing Search" Margin="0,4" IsChecked="{Binding RemoveBingSearch, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Office 365 Hub" Margin="0,4" IsChecked="{Binding RemoveOffice365, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <CheckBox Content="Удалить Skype" Margin="0,4" IsChecked="{Binding RemoveSkype, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </UniformGrid>
                            </ScrollViewer>
                        </Grid>
                    </ui:Card>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. ПОДВАЛ -->
        <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBlock Text="Конфигуратор соберёт файлы ответов OOBE на базе UnattendGenerator." VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Отмена" Width="90" Click="CancelButton_Click" Margin="0,0,10,0"/>
                    <ui:Button Content="Применить" Width="100" Appearance="Primary" Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>