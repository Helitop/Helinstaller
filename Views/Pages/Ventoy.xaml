<Page
    x:Class="Helinstaller.Views.Pages.Ventoy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <!-- Верхняя часть: Управление накопителем + Запись -->
            <RowDefinition Height="Auto"/>
            <!-- Нижняя часть: Образы на накопителе -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. ВЕРХНЯЯ СЕКЦИЯ (2 Сбалансированные колонки)            -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: Накопитель, Память и Ventoy -->
            <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Выбор диска -->
                        <RowDefinition Height="Auto"/>
                        <!-- Статус диска + Ventoy -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка выбора диска -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок + кнопка помощи -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="UsbStick24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <ui:TextBlock Text="Накопитель" FontTypography="Subtitle" FontWeight="SemiBold"/>
                            </StackPanel>

                            <ui:Button Content="Помощь"
                                       Icon="{ui:SymbolIcon QuestionCircle24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Right"
                                       Click="ShowHelpButton_Click"
                                       Padding="8,4"/>
                        </Grid>

                        <!-- Селектор флешки + кнопка обновления -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="DrivesListView"
                                      ItemsSource="{Binding UsbDrives}"
                                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                            <ui:Button x:Name="RefreshButton"
                                       Grid.Column="1"
                                       Width="36" Height="36"
                                       IsEnabled="{Binding IsRefreshEnabled}"
                                       Click="RefreshButton_Click"
                                       ToolTip="Обновить список накопителей"
                                       Padding="0">
                                <Grid>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" Visibility="{Binding IconVisibility}"/>
                                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding RingVisibility}"/>
                                </Grid>
                            </ui:Button>
                        </Grid>
                    </Grid>

                    <!-- Две внутренние плашки: Память | Загрузчик Ventoy -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. Память накопителя -->
                        <Border Grid.Column="0" 
                                Margin="0,0,6,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ui:TextBlock Grid.Row="0" Text="Статус памяти" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>

                                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8">
                                    <ui:ProgressRing Progress="{Binding SelectedDrive.UsedPercent, FallbackValue=0}"
                                                     Width="78" Height="78"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ui:TextBlock Text="{Binding SelectedDrive.UsedPercent, StringFormat={}{0:F0}%, FallbackValue=0%}"
                                                      FontTypography="BodyStrong" HorizontalAlignment="Center"/>
                                        <ui:TextBlock Text="Занято" FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <ui:TextBlock Grid.Row="2"
                                              Text="{Binding DeviceRightText}"
                                              TextWrapping="Wrap"
                                              HorizontalAlignment="Center"
                                              TextAlignment="Center"
                                              FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="0,0,0,8"/>

                                <ui:Button Grid.Row="3"
                                           Content="Форматировать"
                                           HorizontalAlignment="Stretch"
                                           Appearance="Danger"
                                           Click="FormatButton_Click"
                                           IsEnabled="{Binding CanFormat}"/>
                            </Grid>
                        </Border>

                        <!-- 2. Загрузчик Ventoy -->
                        <Border Grid.Column="1" 
                                Margin="6,0,0,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ui:TextBlock Grid.Row="0" Text="Загрузчик Ventoy" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>

                                <ui:TextBlock Grid.Row="1"
                                              Text="Создает загрузочную структуру Ventoy. После установки ISO/IMG образы можно просто копировать на флешку обычным перетаскиванием."
                                              TextAlignment="Center"
                                              TextWrapping="Wrap"
                                              FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              VerticalAlignment="Center"
                                              Margin="4,8"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button x:Name="UpdateButton"
                                               Content="Обновить"
                                               Appearance="Secondary"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,4,0"
                                               Click="UpdateButton_Click"/>

                                    <ui:Button x:Name="InstallButton"
                                               Content="Установить"
                                               Appearance="Primary"
                                               Grid.Column="1"
                                               Margin="4,0,0,0"
                                               HorizontalAlignment="Stretch"
                                               Click="InstallButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- ПРАВАЯ КОЛОНКА: Запись образов -->
            <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок + Поиск оригиналов -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <ui:TextBlock Text="Запись образов" FontTypography="Subtitle" FontWeight="SemiBold"/>
                        </StackPanel>

                        <ui:Button Content="Скачать образ"
                                   Icon="{ui:SymbolIcon Globe24}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Right"
                                   Click="SearchImagesButton_Click"
                                   Padding="8,4"
                                   ToolTip="Открыть каталог оригинальных образов Windows"/>
                    </Grid>

                    <!-- Основная форма -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <ui:InfoBar Title="Автоперехват"
                                    Message="Helinstaller отслеживает папку «Загрузки» и предложит скопировать скачанный образ."
                                    Severity="Informational"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Margin="0,0,0,10"/>

                        <ui:TextBlock Text="Путь к файлу образа" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="LocalFilePathTextBox"
                                        PlaceholderText="Выберите или вставьте путь к .ISO/.IMG..."
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                            <ui:Button x:Name="Browse"
                                       Content="Обзор"
                                       Appearance="Secondary"
                                       Grid.Column="1"
                                       Click="BrowseButton_Click"/>
                        </Grid>

                        <ProgressBar x:Name="progressBar" Height="4" Margin="0,4,0,4" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <ui:TextBlock x:Name="isoText" HorizontalAlignment="Center" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Кнопки действия -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button x:Name="DownloadButton"
                                   Content="Записать на флешку"
                                   Icon="{ui:SymbolIcon ArrowCircleRight24}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,8,0"
                                   Click="DownloadButton_Click"/>

                        <ui:Button x:Name="CancelButton"
                                   Content="Отмена"
                                   Appearance="Secondary"
                                   Grid.Column="1"
                                   Click="CancelButton_Click"
                                   IsEnabled="False"/>
                    </Grid>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2. НИЖНЯЯ СЕКЦИЯ (Менеджер образов на накопителе)         -->
        <!-- ========================================================= -->
        <ui:Card Grid.Row="1" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка нижней карточки -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="FolderZip24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Образы на флешке" FontTypography="Subtitle" FontWeight="SemiBold"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1"
                               Content="Автоустановка (OOBE)"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Wrench24}"
                               HorizontalAlignment="Right"
                               Click="InjectOnlyButton_Click"
                               ToolTip="Записать autounattend.xml и ventoy.json на накопитель"/>
                </Grid>

                <!-- Горизонтальная лента образов -->
                <ListBox Grid.Row="1"
                         x:Name="ImagesList"
                         ItemsSource="{Binding FoundIsoImages}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VerticalAlignment="Center">

                    <!-- Шаблон пустого списка (Empty State) -->
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FoundIsoImages.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Padding="20"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="DocumentDatabase24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8"/>
                                                        <ui:TextBlock Text="Образы ISO / IMG не найдены в папке /ISO/ на накопителе"
                                                                      FontTypography="Body"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Компактная карточка образа -->
                            <Border Width="260"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка диска -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="6"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Margin="0,0,8,0">
                                        <ui:SymbolIcon Symbol="Cd16" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>

                                    <!-- Название и размер -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <ui:TextBlock Text="{Binding FileName}"
                                                      FontTypography="BodyStrong"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding FullPath}"
                                                      Margin="0,0,0,2"/>

                                        <ui:TextBlock Text="{Binding Size}"
                                                      FontTypography="Caption"
                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Удалить -->
                                    <ui:Button Grid.Column="2"
                                               Click="DeleteCardButton_Click"
                                               Appearance="Primary"
                                               Width="32" Height="32"
                                               Padding="0"
                                               ToolTip="Удалить этот образ">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>
    </Grid>
</Page>