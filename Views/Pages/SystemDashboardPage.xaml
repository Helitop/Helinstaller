<!-- FILE [XAML]: .\Views\Pages\SystemDashboardPage.xaml -->

<Page
    x:Class="Helinstaller.Views.Pages.SystemDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d" Title="SystemDashboardPage"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <LinearGradientBrush x:Key="AccentChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0.0"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RamChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8E72B5" Offset="0.0"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GpuChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#52A877" Offset="0.0"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NetChartAreaBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B97C2" Offset="0.0"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid Margin="20,10,20,15">
        <Grid.RowDefinitions>
            <!-- 0. Компактное приветствие -->
            <RowDefinition Height="Auto"/>
            <!-- 1. Спецификации и Монитор ресурсов -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Локальные накопители -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. ШАПКА -->
        <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" 
                        Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.9">
                    <ui:SymbolIcon Symbol="WindowShield24" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="Helinstaller" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                        <ui:TextBlock Text="• Панель мониторинга железа" FontSize="12" Opacity="0.5" Margin="6,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Мониторинг ресурсов, температурных показателей и состояния накопителей в реальном времени." 
                                 FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 1. ВЕРХНЯЯ СЕКЦИЯ -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КАРТОЧКА: Характеристики + Батарея -->
            <ui:Card Grid.Column="0" Margin="0,0,10,0" Padding="16" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Характеристики системы" FontTypography="Subtitle" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Процессор -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="18" Opacity="0.6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Центральный процессор" FontSize="10" Opacity="0.5" Margin="0,0,0,1"/>
                                <ui:TextBlock Text="{Binding ViewModel.CpuName, FallbackValue='Загрузка...'}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4" Opacity="0.25"/>

                        <!-- Видеокарта -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Opacity="0.6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Видеоадаптер" FontSize="10" Opacity="0.5" Margin="0,0,0,1"/>
                                <ui:TextBlock Text="{Binding ViewModel.GpuName, FallbackValue='Загрузка...'}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4" Opacity="0.25"/>

                        <!-- ОЗУ -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Memory16" FontSize="18" Opacity="0.6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Оперативная память" FontSize="10" Opacity="0.5" Margin="0,0,0,1"/>
                                <ui:TextBlock Text="{Binding ViewModel.TotalRamText, FallbackValue='Загрузка...'}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4" Opacity="0.25"/>

                        <!-- ОС -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="WindowSettings20" FontSize="18" Opacity="0.6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Операционная система" FontSize="10" Opacity="0.5" Margin="0,0,0,1"/>
                                <ui:TextBlock Text="{Binding ViewModel.OsVersionText, FallbackValue='Загрузка...'}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Блок батареи ноутбука (Появляется только если есть аккумулятор) -->
                    <Border Grid.Row="2" Background="#104CD964" CornerRadius="8" Padding="10,6" Margin="0,8,0,0"
                            Visibility="{Binding ViewModel.IsBatteryPresent, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="16" Foreground="#4CD964" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ViewModel.BatteryStatusText}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Состояние батареи" FontSize="9" Opacity="0.5"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.BatteryHealthText}" FontSize="11" FontWeight="Bold" Foreground="#4CD964" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>

            <!-- ПРАВАЯ КАРТОЧКА: Монитор ресурсов с графиками и температурами -->
            <ui:Card Grid.Column="1" Margin="10,0,0,0" Padding="15" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:TextBlock Grid.Row="0" Text="Производительность ресурсов" FontTypography="Subtitle" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="4,0,0,10"/>
                    <ui:TextBlock Grid.Row="0" Text="за последние 30 сек." FontTypography="Caption" VerticalAlignment="Center" Appearance="Tertiary" FontWeight="ExtraLight" HorizontalAlignment="Right" Margin="4,0,0,10"/>

                    <UniformGrid Grid.Row="1" Rows="2" Columns="2" VerticalAlignment="Center">

                        <!-- 1. ЦП (С индикатором температуры) -->
                        <ui:Card BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="15" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" Opacity="0.8"/>
                                        <ui:TextBlock Text="ЦП" FontSize="11" FontWeight="SemiBold" Opacity="0.6"/>
                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ViewModel.CpuTempText}" FontSize="9" Opacity="0.75"/>
                                        </Border>
                                    </StackPanel>
                                    <ui:TextBlock Text="{Binding ViewModel.CpuUsage, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Viewbox Grid.Row="1" Stretch="Fill">
                                    <Grid Width="100" Height="36">
                                        <Polygon Points="{Binding ViewModel.CpuPolyPoints}" Fill="{StaticResource AccentChartAreaBrush}" Opacity="0.08"/>
                                        <Polyline Points="{Binding ViewModel.CpuLinePoints}" 
                                                  Stroke="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" 
                                                  StrokeThickness="1.5" 
                                                  StrokeLineJoin="Round" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  Opacity="0.85"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </ui:Card>

                        <!-- 2. ОЗУ -->
                        <ui:Card BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Memory16" FontSize="15" Foreground="#8E72B5" Margin="0,0,6,0" Opacity="0.85"/>
                                        <ui:TextBlock Text="ОЗУ" FontSize="11" FontWeight="SemiBold" Opacity="0.6"/>
                                    </StackPanel>
                                    <ui:TextBlock Text="{Binding ViewModel.RamUsagePercent, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Viewbox Grid.Row="1" Stretch="Fill">
                                    <Grid Width="100" Height="36">
                                        <Polygon Points="{Binding ViewModel.RamPolyPoints}" Fill="{StaticResource RamChartAreaBrush}" Opacity="0.09"/>
                                        <Polyline Points="{Binding ViewModel.RamLinePoints}" 
                                                  Stroke="#8E72B5" 
                                                  StrokeThickness="1.5" 
                                                  StrokeLineJoin="Round" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  Opacity="0.85"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </ui:Card>

                        <!-- 3. ГП (С индикатором температуры) -->
                        <ui:Card BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="15" Foreground="#52A877" Margin="0,0,6,0" Opacity="0.85"/>
                                        <ui:TextBlock Text="ГП" FontSize="11" FontWeight="SemiBold" Opacity="0.6"/>
                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ViewModel.GpuTempText}" FontSize="9" Opacity="0.75"/>
                                        </Border>
                                    </StackPanel>
                                    <ui:TextBlock Text="{Binding ViewModel.GpuUsage, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Viewbox Grid.Row="1" Stretch="Fill">
                                    <Grid Width="100" Height="36">
                                        <Polygon Points="{Binding ViewModel.GpuPolyPoints}" Fill="{StaticResource GpuChartAreaBrush}" Opacity="0.09"/>
                                        <Polyline Points="{Binding ViewModel.GpuLinePoints}" 
                                                  Stroke="#52A877" 
                                                  StrokeThickness="1.5" 
                                                  StrokeLineJoin="Round" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  Opacity="0.85"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </ui:Card>

                        <!-- 4. Сеть -->
                        <ui:Card BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12,8" Margin="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="NetworkAdapter16" FontSize="15" Foreground="#5B97C2" Margin="0,0,6,0" Opacity="0.85"/>
                                        <ui:TextBlock Text="Сеть" FontSize="11" FontWeight="SemiBold" Opacity="0.6"/>
                                    </StackPanel>
                                    <ui:TextBlock Text="{Binding ViewModel.NetworkSpeedText, FallbackValue='0 KB/s'}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                </Grid>

                                <Viewbox Grid.Row="1" Stretch="Fill">
                                    <Grid Width="100" Height="36">
                                        <Polygon Points="{Binding ViewModel.NetPolyPoints}" Fill="{StaticResource NetChartAreaBrush}" Opacity="0.09"/>
                                        <Polyline Points="{Binding ViewModel.NetLinePoints}" 
                                                  Stroke="#5B97C2" 
                                                  StrokeThickness="1.5" 
                                                  StrokeLineJoin="Round" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round"
                                                  Opacity="0.85"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </ui:Card>

                    </UniformGrid>

                    <!-- Нижняя строка -->
                    <Border Grid.Row="2" Background="#06FFFFFF" CornerRadius="8" Padding="10,6" Margin="4,8,4,2">
                        <Grid>
                            <ui:TextBlock Text="{Binding ViewModel.RamUsageText}" FontSize="11" Foreground="Gray" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" Opacity="0.45"/>
                                <ui:TextBlock Text="{Binding ViewModel.UptimeText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- 2. НИЖНЯЯ СЕКЦИЯ: Диски с индикаторами S.M.A.R.T. -->
        <ui:Card Grid.Row="2" Padding="20" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <ui:SymbolIcon Symbol="Storage24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                    <ui:TextBlock Text="Локальные накопители (S.M.A.R.T. Мониторинг)" FontTypography="Subtitle" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Скелетон дисков -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding ViewModel.Disks.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <Control Style="{StaticResource SkeletonBox}" Width="260" Height="85" Margin="0,0,12,0"/>
                    <Control Style="{StaticResource SkeletonBox}" Width="260" Height="85"/>
                </StackPanel>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding ViewModel.Disks}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Width="270" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Шапка диска -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.85"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#184CD964" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding HealthPercent, StringFormat='{}{0}%'}" FontSize="9" Foreground="#4CD964" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DriveLetter, StringFormat='Диск ({0})'}" FontSize="10" Opacity="0.5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <ui:TextBlock Text="{Binding UsedPercent, StringFormat={}{0:F0}%}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding TemperatureText}" FontSize="9" Opacity="0.6" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Полоса занятости -->
                                    <ProgressBar Grid.Row="1" Value="{Binding UsedPercent}" Height="4" Margin="0,0,0,8" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                                    <!-- Футер -->
                                    <Grid Grid.Row="2">
                                        <ui:TextBlock Text="{Binding FreeSpaceText, StringFormat='Свободно: {0}'}" HorizontalAlignment="Left" Foreground="Gray" FontSize="10.5"/>
                                        <ui:TextBlock Text="{Binding TotalSpaceText, StringFormat='Всего: {0}'}" HorizontalAlignment="Right" Foreground="Gray" FontSize="10.5"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>
    </Grid>
</Page>